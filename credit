RESULT_COMMAND = """---
description: Bring the last terminal `credit` exchange into this window
allowed-tools: Bash(credit --take)
---

Below is what the user said in the terminal `credit` tool, continuing this conversation. Remember it and carry on from it.
Use no tools. Print the text below exactly as is, without changing a character. Add nothing.

!`credit --take`
"""
CLAUDE_MD = os.path.join(CLAUDE_DIR, "CLAUDE.md")
RESULT_MD = os.path.join(CLAUDE_DIR, "commands", "credit-result.md")
BLOCK_RE = re.compile(r"\n*" + re.escape(MARK_START) + r".*?" + re.escape(MARK_END) + r"\n?", re.S)


def read_md():
    # None if missing; exits (changing nothing) if it isn't UTF-8
    try:
        with open(CLAUDE_MD, encoding="utf8", newline="") as f:
            return f.read()
    except FileNotFoundError:
        return None
    except UnicodeDecodeError:
        sys.exit(T["md_bad"])


def write_md(text):
    tmp = CLAUDE_MD + ".credit-tmp"
    with open(tmp, "w", encoding="utf8", newline="") as f:
        f.write(text)
    os.replace(tmp, CLAUDE_MD)


def vscode_enabled():
    try:
        return MARK_START in (read_md() or "")
    except SystemExit:
        return False


def vscode_on():
    # adds (or refreshes) only the marked block; the rest of CLAUDE.md is left as it is
    text = read_md() or ""
    block = f"{MARK_START}\n{RULE[LANG]}\n{MARK_END}\n"
    if MARK_START in text and not BLOCK_RE.search(text):
        sys.exit(T["md_marker"])  # a start marker without an end: leave the file alone
    if MARK_START in text:
        text = BLOCK_RE.sub(lambda m: ("\n\n" if m.start() else "") + block, text, count=1)
    else:
        text = text + ("\n" if text and not text.endswith("\n") else "") + ("\n" if text else "") + block
    os.makedirs(os.path.dirname(RESULT_MD), exist_ok=True)
    write_md(text)
    with open(RESULT_MD, "w", encoding="utf8") as f:
        f.write(RESULT_COMMAND)


def vscode_off():
    text = read_md()
    if text and BLOCK_RE.search(text):
        rest = BLOCK_RE.sub("\n", text, count=1)
        write_md(rest if rest.strip() else "")
    if os.path.exists(RESULT_MD):
        os.remove(RESULT_MD)


# ---- status and settings ----

def status():
    cfg = load_config()
    rows = [
        (T["s_month"], f"${this_month()[0]:.2f}"),
        (T["s_cap"], f"${num(cfg['max_per_message'], 10.0):.2f}"),
        (T["s_model"], cfg.get("model") or "auto"),
        (T["s_vscode"], T["s_on"] if vscode_enabled() else T["s_off"]),
        (T["s_key"], T["s_saved"] if read_key() else T["s_missing"]),
        (T["s_console"], BILLING_URL),
    ]
    print(T["s_title"] + "\n")
    for name, value in rows:
        print(f"  {name}: {value}")
    if cfg.get("model") == "fable":
        print("\n  " + T["s_fable"])
    print("\n" + T["see_help"])


def guide():
    print(T["guide"] + "".join("  " + line + "\n" for line in T["help"].splitlines()) + T["guide_end"], end="")


def delete_key():
    if not read_key():
        return False
    if WIN:
        keyring().delete_password(SERVICE, getpass.getuser())
    else:
        subprocess.run(["security", "delete-generic-password", "-a", getpass.getuser(), "-s", SERVICE],
                       capture_output=True)
    return not read_key()


def uninstall():
    if input(T["un_confirm"]).strip().lower() not in ("y", "yes"):
        return print(T["un_none"])
    had_rule, had_md = vscode_enabled(), os.path.exists(RESULT_MD)
    vscode_off()  # only the marked block; the rest of CLAUDE.md stays
    gone = ([T["un_rule"]] if had_rule else []) + ([RESULT_MD] if had_md else [])
    for d in (CREDIT_DIR, os.path.dirname(log_path())):
        if os.path.isdir(d):
            shutil.rmtree(d, ignore_errors=True)
            if not os.path.isdir(d):
                gone.append(d)
    if delete_key():
        gone.append(T["un_key"])
    bin_dir = os.path.join(os.path.expanduser("~"), ".local", "bin")
    for name in ("credit", "credit.py", "credit.cmd"):
        path = os.path.join(bin_dir, name)
        if os.path.isfile(path):
            os.remove(path)
            gone.append(path)
    print(T["un_done"] if gone else T["un_none"])
    for g in gone:
        print("  " + g)


def set_value(args):
    names = {"cap": "max_per_message", "model": "model"}
    if len(args) != 2 or args[0] not in names:
        sys.exit(T["set_usage"])
    name, value = names[args[0]], args[1]
    if name == "model":
        if value not in ("auto", *MODELS):
            sys.exit(T["set_usage"])
    else:
        try:
            value = float(value)
        except ValueError:
            sys.exit(T["set_usage"])
    cfg = load_config()
    cfg[name] = value
    save_config(cfg)
    print(T["set_done"].format(name, value))


def main():
    args = sys.argv[1:]
    sub = args[0] if args else ""
    if hasattr(sys.stdout, "reconfigure"):
        sys.stdout.reconfigure(errors="replace")  # a Windows console can't print every character
    if sub == "--take":
        return take()
    if sub == "":
        return status()
    if sub == "key":
        return set_key()
    if sub == "set":
        return set_value(args[1:])
    if sub == "run":
        return run(args[1:])
    if sub in ("help", "-h", "--help"):
        return guide()
    if sub == "uninstall":
        return uninstall()
    if sub == "_install-vscode":  # called by install.sh / install.ps1
        return vscode_on()
    print(T["help"], end="")


if __name__ == "__main__":
    try:
        main()
    except (KeyboardInterrupt, EOFError):
        print()
