def folder_id(folder=None):
    return re.sub(r"[^A-Za-z0-9]", "-", folder or os.getcwd())


def log_path(folder=None):
    return os.path.join(CLAUDE_DIR, "credit-last", folder_id(folder) + ".md")


# ---- conversation files ----

def info(path):
    with open(path, "rb") as f:
        f.seek(0, 2)
        f.seek(max(0, f.tell() - 6_000_000))
        lines = f.read().decode("utf8", "ignore").splitlines()
    model = title = None
    for line in reversed(lines):
        try:
            r = json.loads(line)
        except ValueError:
            continue
        if not model and r.get("type") == "assistant":
            m = (r.get("message") or {}).get("model") or ""
            if m.startswith("claude"):
                model = m
        if not title and r.get("type") == "ai-title":
            title = r.get("aiTitle") or r.get("title")
        if not title and r.get("type") == "last-prompt":
            title = r.get("lastPrompt")
        if model and title:
            break
    return model, " ".join((title or T["untitled"]).split())[:40]


def take():
    # /credit-result: print the last exchange once, then clear it
    try:
        with open(log_path(), encoding="utf8") as f:
            print(f.read() or T["no_reply"])
        os.remove(log_path())
    except FileNotFoundError:
        print(T["no_reply"])


# ---- spending log (local; the remaining balance is only on the Console) ----

def read_json(path, default):
    try:
        with open(path, encoding="utf8") as f:
            return json.load(f)
    except (FileNotFoundError, ValueError):
        return default


def write_json(path, data):
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf8") as f:
        json.dump(data, f, ensure_ascii=False, indent=1)
    os.replace(tmp, path)


def add_cost(last, sid, total):
    # total_cost_usd of a --resume run is the whole conversation so far: count only the growth
    prev = last.get(sid, 0.0) if sid else 0.0
    if sid:
        last[sid] = total
    return total - prev if total >= prev else total


def migrate_spend(rows):
    # version 1 stored each run's total_cost_usd as is
    data = {"version": 2, "last": {}, "entries": []}
    for r in sorted(rows, key=lambda r: r.get("t", 0)):
        cost = add_cost(data["last"], r.get("sid"), float(r.get("cost") or 0))
        data["entries"].append({**r, "cost": round(cost, 6)})
    return data


def load_spend():
    data = read_json(SPEND_FILE, None)
    if isinstance(data, list):
        data = migrate_spend(data)
        write_json(SPEND_FILE, data)
    if not isinstance(data, dict):
        data = {}
    if not isinstance(data.get("last"), dict):
        data["last"] = {}
    if not isinstance(data.get("entries"), list):
        data["entries"] = []
    data["version"] = 2
    return data


def record_spend(sid, title, model, total, folder=None, resumed=None):
    # returns what this message cost
    data = load_spend()
    if resumed and sid != resumed and resumed in data["last"] and sid not in data["last"]:
        data["last"][sid] = data["last"][resumed]
    cost = add_cost(data["last"], sid, num(total))
    data["entries"].append({"t": time.time(), "sid": sid, "title": title, "folder": folder or os.getcwd(),
                            "model": model, "cost": round(cost, 6)})
    write_json(SPEND_FILE, data)
    return cost


def num(v, default=0.0):
    try:
        return float(v)
    except (TypeError, ValueError):
        return default


def spent_since(t0):
    return sum(num(r.get("cost")) for r in load_spend()["entries"] if isinstance(r, dict) and num(r.get("t")) > t0)


def this_month():
    month = time.strftime("%Y-%m")
    rows = [r for r in load_spend()["entries"]
            if isinstance(r, dict) and time.strftime("%Y-%m", time.localtime(num(r.get("t")))) == month]
    by_conv = {}
    for r in rows:
        c = by_conv.setdefault(r.get("sid") or "?", {**r, "cost": 0.0})
        c["cost"] += num(r.get("cost"))
        c["model"] = r.get("model") or c["model"]
    convs = sorted(by_conv.values(), key=lambda c: c["cost"], reverse=True)
    return sum(c["cost"] for c in convs), convs


# ---- settings and the pre-send check ----

def load_config():
    cfg = read_json(CONFIG_FILE, {})
    return {**CONFIG_DEFAULTS, **(cfg if isinstance(cfg, dict) else {})}


def save_config(cfg):
    write_json(CONFIG_FILE, {k: cfg.get(k, v) for k, v in CONFIG_DEFAULTS.items()})


def check(cfg):
    # -> (block message or None, budget for --max-budget-usd); running out is caught from the API reply
    cap = num(cfg["max_per_message"], 10.0)
    return (T["no_credit"], 0) if cap < 0.01 else (None, cap)


def pick_model(name, session_model):
    # `credit opus|sonnet|fable` / --model, then the config, then the conversation's last model, then opus
    if name:
        return MODELS.get(name, name)
    cfg_model = load_config().get("model") or "auto"
    if cfg_model != "auto":
        return MODELS.get(cfg_model, cfg_model)
    return session_model or MODELS[DEFAULT_MODEL]


# ---- key ----

def keyring():
    try:
        import keyring as kr
        return kr
    except ImportError:
        sys.exit(T["no_keyring"])


def read_key():
    if WIN:
        kr = keyring()
        try:
            return kr.get_password(SERVICE, getpass.getuser())
        except Exception:
            return None
    out = subprocess.run(["security", "find-generic-password", "-a", getpass.getuser(), "-s", SERVICE, "-w"],
                         capture_output=True, text=True)
    return out.stdout.strip() if out.returncode == 0 else None


def save_key(key):
    if not re.fullmatch(KEY_RE, key):
        return False
    if WIN:
        keyring().set_password(SERVICE, getpass.getuser(), key)
        return read_key() == key
    # through `security -i` stdin, so the key never shows up in the process list
    cmd =f'add-generic-password -U -a "{getpass.getuser()}" -s "{SERVICE}" -w "{key}"\n'
    out = subprocess.run(["security", "-i"], input=cmd, capture_output=True, text=True)
    return out.returncode == 0 and read_key() == key


def confirm_console():
    print(T["setup"])
    for c in ("c1",):
        if input(T["confirm"].format(T[c])).strip().lower() not in ("y", "yes"):
            sys.exit(T["confirm_fail"])


def ask_key():
    key = getpass.getpass(T["key_prompt"]).strip()
    if not re.fullmatch(KEY_RE, key):
        sys.exit(T["key_bad"])
    return key


def set_key():
    confirm_console()
    if not save_key(ask_key()):
        sys.exit(T["key_fail"])
    print(T["key_saved"])


def get_key():
    key = read_key()
    if not key:
        sys.exit(T["need_key"])
    return key


