    # Like `env -i`: if VS Code's variables leak in, claude runs on the subscription instead of the key.
    # No --bare either: it drops the credit.
    if WIN:
        names = ("SYSTEMROOT", "SYSTEMDRIVE", "WINDIR", "COMSPEC", "PATH", "PATHEXT", "TEMP", "TMP",
                 "APPDATA", "LOCALAPPDATA", "USERPROFILE", "HOMEDRIVE", "HOMEPATH", "USERNAME",
                 "PROGRAMDATA", "PROGRAMFILES", "PROGRAMFILES(X86)", "NUMBER_OF_PROCESSORS", "PROCESSOR_ARCHITECTURE")
        keep = {k: os.environ[k] for k in names if k in os.environ}
    else:
        keep = {k: os.environ[k] for k in ("HOME", "USER", "LOGNAME", "PATH") if k in os.environ}
        keep.update(SHELL=os.environ.get("SHELL", "/bin/zsh"), TERM="xterm-256color",
                    LANG=os.environ.get("LANG", "en_US.UTF-8"))
    keep["ANTHROPIC_API_KEY"] = key
    return keep


def claude_exe():
    exe = (WIN and shutil.which("claude.exe")) or shutil.which("claude")
    if not exe:
        sys.exit(T["no_claude"])
    return exe


def call_claude(key, sid, model, text, budget, folder=None):
    exe = claude_exe()
    cmd = [exe, "-p", "--model", model, "--allowedTools", TOOLS, "--max-budget-usd", f"{budget:.2f}",
           "--output-format", "json"]
    if sid:
        cmd += ["--resume", sid]
    # a .cmd shim goes through cmd.exe, which mangles arguments: give it the message on stdin instead
    via_stdin = exe.lower().endswith((".cmd", ".bat"))
    # a full env= replaces the environment like `env -i`, and keeps the key out of argv
    out = subprocess.run(cmd if via_stdin else cmd + [text], input=text if via_stdin else None,
                         env=clean_env(key), cwd=folder, capture_output=True, text=True, encoding="utf8", errors="replace")
    try:
        r = json.loads(out.stdout.strip().splitlines()[-1])
    except (ValueError, IndexError):
        r = None
    if not isinstance(r, dict) or r.get("is_error"):
        said = (out.stdout + out.stderr).lower()
        if "credit balance is too low" in said:
            raise NoCredit(T["no_credit"])
        if "invalid api key" in said or "authentication_error" in said or "invalid x-api-key" in said:
            raise BadKey(T["bad_key"])
        # any other failure is not a reply: show it and don't record a cost
        msg = r.get("result") if isinstance(r, dict) else None
        print(msg or out.stdout or out.stderr, file=sys.stderr)
        return None
    return r


def send(key, sid, model, title, text, folder=None):
    # one message, with the cap. -> (session id, reply, cost) or None on failure
    block, budget = check(load_config())
    if block:
        raise NoCredit(block)
    r = call_claude(key, sid, model, text, budget, folder)
    if r is None:
        return None
    reply = str(r.get("result") or r.get("subtype") or r)
    os.makedirs(os.path.dirname(log_path(folder)), exist_ok=True)
    with open(log_path(folder), "w", encoding="utf8") as f:
        f.write(f"{T['you']}: {text}\n\n{T['reply']}: {reply}\n\n")
    cost = record_spend(r.get("session_id") or sid, title, model, r.get("total_cost_usd", 0), folder, resumed=sid)
    return r.get("session_id") or sid, reply, cost


def cost_line(cost):
    return T["this"].format(cost) + " · " + T["month"].format(this_month()[0])


def session_model(sid, folder=None):
    path = os.path.join(CLAUDE_DIR, "projects", folder_id(folder), f"{sid}.jsonl")
    return info(path)[0] if sid and os.path.exists(path) else None


def run(args):
    # credit run "message" [--new] [--model X]: no chat; keeps one conversation per folder
    text, new, name, i = None, False, None, 0
    while i < len(args):
        if args[i] == "--new":
            new = True
        elif args[i] == "--model" and i + 1 < len(args):
            name = args[i + 1]
            i += 1
        elif text is None:
            text = args[i]
        i += 1
    if not text or not text.strip():
        sys.exit(T["run_usage"])
    runs = read_json(RUN_FILE, {})
    runs = runs if isinstance(runs, dict) else {}
    sid = None if new else runs.get(folder_id())
    model = pick_model(name, session_model(sid))
    key = get_key()
    try:
        res = send(key, sid, model, " ".join(text.split())[:40], text)
    except NoCredit as e:
        print(e)
        sys.exit(NO_CREDIT_EXIT)
    except BadKey as e:
        print(e)
        sys.exit(BAD_KEY_EXIT)
    if res is None:
        sys.exit(1)
    sid, reply, cost = res
    runs[folder_id()] = sid
    write_json(RUN_FILE, runs)
    print(reply + "\n\n[" + cost_line(cost) + "]")


