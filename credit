def lang():
    if MAC:
        out = subprocess.run(["defaults", "read", "-g", "AppleLanguages"], capture_output=True, text=True)
        m = re.search(r'"?([A-Za-z]{2})', out.stdout)
        return "ko" if m and m.group(1).lower() == "ko" else "en"
    if WIN:
        import ctypes
        return "ko" if ctypes.windll.kernel32.GetUserDefaultUILanguage() & 0x3FF == 0x12 else "en"
    return "ko" if (os.environ.get("LC_ALL") or os.environ.get("LANG") or "").lower().startswith("ko") else "en"


